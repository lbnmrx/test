---
// COMPOSANT INTERACTIF (un « îlot ») : le mini-planning de l'étape 3.
// Le reste du site est du HTML figé ; seule cette zone embarque du JavaScript.
const jours = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi"];
---

<form id="formulaire">
  <input id="tache" type="text" placeholder="Ex. : Rendre le banc d'essai" required />
  <select id="jour">
    {jours.map((jour) => <option>{jour}</option>)}
  </select>
  <button type="submit">Ajouter</button>
</form>

<ul id="liste"></ul>

<script>
  // FONCTIONNEMENT : ce code-là est bien envoyé au navigateur.
  const formulaire = document.getElementById("formulaire") as HTMLFormElement;
  const champTache = document.getElementById("tache") as HTMLInputElement;
  const choixJour = document.getElementById("jour") as HTMLSelectElement;
  const liste = document.getElementById("liste") as HTMLUListElement;

  formulaire.addEventListener("submit", (evenement) => {
    evenement.preventDefault();
    const ligne = document.createElement("li");
    ligne.innerHTML = "<span></span><span class='jour'></span>";
    ligne.children[0].textContent = champTache.value;
    ligne.children[1].textContent = choixJour.value;
    liste.appendChild(ligne);
    champTache.value = "";
  });
</script>

<style>
  form { display: flex; gap: 8px; margin: 24px 0; }
  input, select, button {
    font: inherit; padding: 10px 12px; border-radius: 10px; border: 1px solid #cfd6c8;
  }
  input { flex: 1; }
  button { background: #8cc757; border-color: #8cc757; color: #1d2318; font-weight: 600; cursor: pointer; }
  ul { list-style: none; padding: 0; }
  /* :global() car les lignes <li> sont créées après coup par le script. */
  ul :global(li) {
    display: flex; justify-content: space-between; align-items: center;
    background: #fff; border: 1px solid #e2e7dc; border-radius: 10px;
    padding: 12px 14px; margin-bottom: 8px;
  }
  ul :global(.jour) { font-size: 0.85em; color: #5b6455; }
</style>

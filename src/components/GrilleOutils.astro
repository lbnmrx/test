---
// COMPOSANT : la grille d'icônes qui donne accès aux outils.
// La liste vient de src/data/outils.js ; ce composant ne fait que l'afficher.
import { outils } from "../data/outils.js";
---

<section>
  <h2 class="text-lg font-semibold mb-4">Outils</h2>
  <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
    {outils.map((outil) => {
      const actif = outil.etat === "actif";
      const Balise = actif ? "a" : "div";
      return (
        <Balise
          href={actif ? outil.adresse : undefined}
          class:list={["tuile card card--default no-underline", { "tuile--active": actif, "tuile--bientot": !actif }]}
        >
          <span class="tuile__icone">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={outil.icone} />
          </span>
          <span class="font-semibold text-foreground">{outil.nom}</span>
          <span class="text-sm text-muted leading-snug">{outil.description}</span>
          {!actif && <span class="chip chip--sm chip--default mt-1 self-start"><span class="chip__label">À venir</span></span>}
        </Balise>
      );
    })}
  </div>
</section>

<style>
  .tuile { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.1rem; transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .tuile--active:hover { transform: translateY(-2px); box-shadow: 0 6px 20px -8px color-mix(in oklch, var(--accent) 70%, transparent); }
  .tuile--bientot { opacity: 0.55; }
  .tuile__icone {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; margin-bottom: 0.4rem;
    background: color-mix(in oklch, var(--accent) 22%, transparent); color: var(--accent-soft-foreground);
  }
  .tuile--bientot .tuile__icone { background: var(--surface-secondary); color: var(--muted); }
</style>

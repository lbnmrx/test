// RÉGLAGES CLOUDFLARE (projet de type « Workers »).
// Ce fichier dit à Cloudflare quoi publier une fois le site fabriqué par Astro.
{
  // Doit porter le même nom que le projet dans le tableau de bord Cloudflare.
  "name": "test",
  "compatibility_date": "2026-11-18",
  // Le petit serveur qui enregistre les réglages des apps (adresse /api/apps).
  "main": "./worker/index.js",
  // Fabrique le site avec Astro juste avant chaque publication, quel que soit
  // le réglage du tableau de bord (production comme aperçus).
  "build": { "command": "npm run build" },
  "assets": {
    // Le dossier fabriqué par « npm run build ».
    "directory": "./dist",
    // Les pages du site, transmises au serveur sous le nom ASSETS.
    "binding": "ASSETS",
    // Seules les adresses /api/… passent par le serveur ; le reste est servi directement.
    "run_worker_first": ["/api/*"],
    // Adresse inconnue → page 404 plutôt qu'une erreur.
    "not_found_handling": "404-page"
  },
  // Stockage des réglages (KV). Sans identifiant : Cloudflare le crée tout seul
  // à la première publication, puis le réutilise.
  "kv_namespaces": [{ "binding": "OS" }],
  // Autorise les aperçus de branche (une adresse de test par pull request).
  "previews": {}
}
